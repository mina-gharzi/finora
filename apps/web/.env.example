# Finora web — environment template.
#
# Copy to `.env` and fill in real values for local development. `.env` is
# gitignored; never commit real secrets. Only this placeholder file is tracked.

# ---------------------------------------------------------------------------
# Database (local development uses Docker Postgres; see README).
# `DATABASE_URL` is used by both the app and drizzle-kit migrations.
# ---------------------------------------------------------------------------
POSTGRES_USER=finora
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=finora
DATABASE_URL=postgres://finora:change-me-local-dev-only@127.0.0.1:15432/finora

# ---------------------------------------------------------------------------
# Session signing secret (HMAC key for the JWT session cookie).
# Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
SESSION_SECRET=change-me-at-least-32-bytes-of-random-data

# ---------------------------------------------------------------------------
# Optional: public origin used to build absolute links in recovery emails
# (scheme + host, optional port, no trailing path). Defaults to the local
# dev server origin when unset.
# ---------------------------------------------------------------------------
# APP_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Email delivery: NO transactional provider is integrated yet.
# - Development/test: messages are logged to the console. Set EMAIL_OUTBOX_DIR
#   to write them as JSON files to a local directory instead (gitignored;
#   never an HTTP endpoint).
# - Production: every send fails with a generic "service unavailable" answer
#   until a real EmailAdapter is implemented in src/lib/email/adapter.ts and
#   its own configuration keys (provider API key / SMTP URL, MAIL_FROM) are
#   added. Do not put provider credentials here until that adapter exists.
# ---------------------------------------------------------------------------
# EMAIL_OUTBOX_DIR=.email-outbox
